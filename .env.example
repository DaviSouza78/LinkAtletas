# OAuth Client ID do tipo "Aplicativo da Web" criado no Google Cloud Console.
# Adicione http://localhost:5173 e a URL de produção em "Origens JavaScript autorizadas".
VITE_GOOGLE_CLIENT_ID=

# Desenvolvimento local com docker compose. Nunca use esta senha em produção.
DATABASE_URL=postgresql://linkatletas:linkatletas_dev@127.0.0.1:54329/linkatletas
TEST_DATABASE_URL=postgresql://linkatletas:linkatletas_dev@127.0.0.1:54329/linkatletas_test
POSTGRES_PASSWORD=linkatletas_dev
APP_ORIGIN=http://localhost:5173
API_PORT=3001
API_HOST=127.0.0.1
BILLING_MODE=academic
REVIEW_MIN_DAYS=7
JOBS_INTERVAL_MS=10000
# Desenvolvimento gera .data-key.local automaticamente, ignorado pelo Git.
# Preserve essa chave com os backups. Produção exige DATA_ENCRYPTION_KEY (32 bytes em base64).
DATA_ENCRYPTION_KEY=
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET=linkatletas-private
S3_ACCESS_KEY=linkatletas-local
S3_SECRET_KEY=local-only-change-in-production
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=LinkAtletas <no-reply@linkatletas.local>
SMTP_USER=
SMTP_PASSWORD=
# Configure somente no servidor; não fornecer estes segredos ao aplicativo.
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_PLATFORM_WALLET_ID=
# Produção exige APP_ORIGIN HTTPS, DATABASE_URL explícita e NODE_ENV=production.
