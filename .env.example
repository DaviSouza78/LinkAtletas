# OAuth Client ID do tipo "Aplicativo da Web" criado no Google Cloud Console.
# Adicione http://localhost:5173 e a URL de produção em "Origens JavaScript autorizadas".
VITE_GOOGLE_CLIENT_ID=

# Desenvolvimento local com docker compose. Nunca use esta senha em produção.
DATABASE_URL=postgresql://linkatletas:linkatletas_dev@127.0.0.1:54329/linkatletas
TEST_DATABASE_URL=postgresql://linkatletas:linkatletas_dev@127.0.0.1:54329/linkatletas_test
POSTGRES_PASSWORD=linkatletas_dev
APP_ORIGIN=http://localhost:5173
API_PORT=3001
# Produção exige APP_ORIGIN HTTPS, DATABASE_URL explícita e NODE_ENV=production.
