{
  "expo": {
    "name": "LinkAtletas",
    "slug": "linkatletas",
    "version": "0.3.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "linkatletas",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.edu.linkatletas.app"
    },
    "android": {
      "package": "br.edu.linkatletas.app"
    },
    "plugins": [
      "expo-secure-store",
      "expo-document-picker",
      "expo-sharing",
      "expo-status-bar"
    ],
    "extra": {
      "projectScope": "academic-athlete-client"
    }
  }
}
