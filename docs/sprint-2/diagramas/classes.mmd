classDiagram
  class Usuario {
    +UUID id
    +string nome
    +string email
    +Papel papel
  }
  class Perfil {
    +UUID usuarioId
    +string cidade
    +string[] modalidades
    +string[] objetivos
    +string[] niveis
    +string[] disponibilidade
    +Modo modo
    +decimal orcamento
    +decimal preco
    +StatusVerificacao verificacao
  }
  class Sessao {
    +string hashToken
    +datetime expiraEm
  }
  class Verificacao {
    +UUID id
    +string cref
    +string referencia
    +StatusVerificacao status
    +string justificativa
  }
  class AuditoriaVerificacao {
    +UUID id
    +UUID administradorId
    +string decisao
    +datetime data
  }
  class Contrato {
    +UUID id
    +UUID atletaId
    +UUID treinadorId
    +StatusContrato status
    +datetime decididoEm
  }
  class FichaTreino {
    +UUID id
    +string titulo
    +string modalidade
    +date dataAgendada
    +string orientacoes
    +StatusFicha status
  }
  class BlocoExercicio {
    +UUID id
    +int posicao
    +JSON definicao
  }
  class TipoMetrica {
    +string modalidade
    +string chave
    +string unidade
    +number minimo
    +number maximo
  }
  class Execucao {
    +UUID id
    +int[] blocosConcluidos
    +int esforco
    +string comentario
    +JSON metricas
    +datetime atualizadaEm
  }
  Usuario "1" *-- "1" Perfil
  Usuario "1" -- "0..*" Sessao
  Usuario "1" -- "0..*" Verificacao : treinador
  Usuario "1" -- "0..*" AuditoriaVerificacao : administrador
  Verificacao "1" -- "0..1" AuditoriaVerificacao
  Usuario "1" -- "0..*" Contrato : atleta
  Usuario "1" -- "0..*" Contrato : treinador
  Contrato "1" -- "0..*" FichaTreino
  FichaTreino "1" *-- "1..*" BlocoExercicio
  FichaTreino "1" -- "0..1" Execucao
  Execucao ..> TipoMetrica : valida por modalidade e chave
